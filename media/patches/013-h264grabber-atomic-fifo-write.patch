+// 诊断镜像：存在触发文件 /tmp/sd/p9-mirror-on 时，把写入 FIFO 的每帧原样
+// 镜像到 /tmp/sd/p9-mirror.h264（上限 24MB 后自动关闭），用于对比
+// 「grabber 写出的字节」与「RTSP 出口的字节」。默认关闭，不影响稳态运行。
+#define P9_MIRROR_TRIGGER "/tmp/sd/p9-mirror-on"
+#define P9_MIRROR_PATH    "/tmp/sd/p9-mirror.h264"
+#define P9_MIRROR_LIMIT   (24u * 1024 * 1024)
+static int gMirrorFd = -1;
+static unsigned gMirrorBytes = 0;
 
+static void mirror_open_if_triggered(void)
+{
+    // 修复(P11b)：high / AUDIO 两个 grabber 进程会同时看到触发文件，
+    // 原实现对同一个路径各自 O_TRUNC 并用独立 fd 写入，视频与音频字节
+    // 互相覆盖交错，镜像本身变成脏数据。按 PID 分文件即可干净对照。
+    if (access(P9_MIRROR_TRIGGER, F_OK) == 0) {
+        char path[128];
+        snprintf(path, sizeof(path), "%s.%d", P9_MIRROR_PATH, (int)getpid());
+        gMirrorFd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    }
+}
+
+static void mirror_write(const unsigned char *buf, unsigned len)
+{
+    if (gMirrorFd < 0) return;
+    if (gMirrorBytes + len > P9_MIRROR_LIMIT) {
+        close(gMirrorFd);
+        gMirrorFd = -1;
+        return;
+    }
+    if (write_all(gMirrorFd, buf, len) == 0)
+        gMirrorBytes += len;
+}
+
+void* unlock_fifo_thread(void *data)
+{
+    // 修复(P9)：原实现 open(O_RDONLY) 后 read 1024 字节再 close——
