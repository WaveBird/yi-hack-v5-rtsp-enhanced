+    // 第一段码流字节错位（裸流里偶发的垃圾 NALU、重启后起播绿屏放大）。
+    // 改为非阻塞打开后立即关闭：只为让写端的 open() 不阻塞，不消费任何数据。
+    int fd = open((char *) data, O_RDONLY | O_NONBLOCK);
+    if (fd >= 0)
+        close(fd);
+
     return NULL;
 }
 
