+// 加固(P18b)：判断一个「新到的 RTP 包」是否为可安全恢复发送的重同步点。
+// 只在视频 RTP 通道(ch=0)上调用：AAC/RTCP 的 payload 不是 H.264 NAL，
+// 用 NAL type 去套会随机命中 5/7/8 而误判成 IDR。
+//   IDR(5) / SPS(7) / PPS(8) / 聚合包 STAP-A..D(24..27) 都是 GOP 起点；
+//   FU-A/FU-B(28/29) 只有 S 位为 1 且 NAL type 为 IDR 时才是起点。
+static Boolean rrtspOutqIsKeyframePacket(u_int8_t const* p, unsigned len) {
+  if (len < 13 || (p[0] & 0xC0) != 0x80) return False;  // 非 RTP v2
+  unsigned hdr = 12u + 4u * (unsigned)(p[0] & 0x0F);    // 固定头 + CSRC
+  if ((p[0] & 0x10) != 0) {                             // X: RTP 扩展头
+    if (hdr + 4 > len) return False;
+    unsigned extWords = ((unsigned)p[hdr + 2] << 8) | p[hdr + 3];
+    hdr += 4u + 4u * extWords;
+  }
+  if (hdr >= len) return False;
+  u_int8_t nalType = p[hdr] & 0x1F;
+  if (nalType == 5 || nalType == 7 || nalType == 8) return True;
+  if (nalType >= 24 && nalType <= 27) return True;       // 聚合包常含参数集+IDR
+  if (nalType == 28 || nalType == 29) {
+    if (hdr + 1 >= len) return False;
+    return (p[hdr + 1] & 0x80) != 0 &&
+           (p[hdr + 1] & 0x1F) == 5;                    // FU-A IDR 首片
+  }
+  return False;
 }
 
