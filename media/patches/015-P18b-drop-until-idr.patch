+// ===== 加固(P18b)：drop-until-IDR 状态取证钩子（节流） =====
+// frames==0 表示 ENTER（刚进入丢新帧状态），>0 表示 EXIT。
+// recoveredByKeyframe=True 表示按预期遇到 IDR/SPS/PPS 恢复；False 表示
+// 2s 防冻结保底超时恢复（现场若频繁出现，说明该相机 GOP 异常长）。
+volatile unsigned gP18bDropCycles = 0;
+extern "C" void rrtspTcpDropUntilIdrNotify(int socketNum, unsigned frames,
+                                           Boolean recoveredByKeyframe) {
+    static time_t lastEnterLog = 0;
+    time_t now = time(NULL);
+    if (frames == 0) {
+        if (now != lastEnterLog) {
+            hardenedLog("P18b: drop-until-idr ENTER socket=%d; queued frames kept intact, connection kept",
+                        socketNum);
+            lastEnterLog = now;
+        }
+        return;
+    }
+    gP18bDropCycles++;
+    hardenedLog("P18b: drop-until-idr EXIT frames=%u by_keyframe=%d cycles=%u socket=%d; connection kept",
+                frames, (int)recoveredByKeyframe, gP18bDropCycles, socketNum);
+}
