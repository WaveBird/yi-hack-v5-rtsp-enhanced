+// 复制器创建失败时优雅退回原有的每会话源路径（不中断服务）。
+static H264VideoFifoServerMediaSubsession* makeVideoSubsession(StreamReplicator* replicator,
+                                                               char const* fifoName) {
+    if (replicator != NULL)
