+// ===== 加固(P2)：视频进程级常驻 StreamReplicator =====
+// 原实现：每个 ServerMediaSubsession 在首个客户端到来时 createNewStreamSource()
+// 新建 ByteStreamFifoSource（open FIFO + 清空残留）；最后一个客户端断开后源被销毁，
+// FIFO 读端关闭，h264grabber 写端失去消费者。P4v2 拆除楔死会话后必须等
+// go2rtc 重连 + FIFO 重新 open + SPS 重新解析，形成 8-10s 断流窗口。
+//
+// 改成：进程启动时一次性建立 ByteStreamFifoSource + StreamReplicator(False)，
+// 并挂一个永不退出的 DummySink replica 保持源持续读 FIFO。客户端会话只持有
+// 独立 replica，拆除时仅回收 replica，底层源与 FIFO 读端始终存活。
+// 于是重连后新 replica 立即拿到当前帧，恢复窗口缩短到只有 RTSP 重连本身。
+// 自持的 FIFO 写端（进程级常驻，故意不 close）。
+// POSIX FIFO 在所有写端都关闭时 read() 返回 0，ByteStreamFifoSource 会当作永久 EOF
+// 调用 handleClosure() —— 常驻源一旦关闭就再也不会重建，会变成永久断流。
+// 自己保留一个不写数据的写端，可保证 h264grabber 重启期间 read() 只会返回 EAGAIN
+// （P1 补丁已处理），而永远不会走 EOF 分支。
+static int gFifoKeepaliveWriteFd[2] = { -1, -1 };
+static int gFifoKeepaliveIndex = 0;
+
+// 冷启动时 h264grabber 可能还没来得及 mkfifo。原实现是「首个客户端到来时」才 open，
+// 天然规避了启动顺序；常驻源改为启动时 open 后就必须显式等待，否则会 fallback
+// 回旧的每会话源，P2 等于白做。最多等 5s，超时仍回退（服务不中断）。
+static void waitForFifo(char const* fifoName) {
+    struct stat st;
+    for (int i = 0; i < 50; ++i) {
+        if (stat(fifoName, &st) == 0 && S_ISFIFO(st.st_mode)) return;
+        usleep(100000); // 100ms
+    }
+}
+
+static StreamReplicator* startVideoReplicator(char const* fifoName, char const* tag) {
+    waitForFifo(fifoName);
+    // 不用 ByteStreamFifoSource::createNew(env, fileName, ...)：它内部以阻塞方式
+    // fopen FIFO，若此刻 h264grabber 写端还没打开会卡死整个进程启动。
+    // 这里先 O_NONBLOCK 打开，再走已有的 FILE* 重载；构造函数仍会把 fd 设为非阻塞。
+    int fd = open(fifoName, O_RDONLY | O_NONBLOCK);
+    if (fd < 0) {
+        hardenedLog("P2: cannot open %s (errno=%d); falling back to per-session source", fifoName, errno);
+        return NULL;
+    }
+    FILE* fid = fdopen(fd, "rb");
+    if (fid == NULL) {
+        close(fd);
+        hardenedLog("P2: fdopen failed for %s; falling back to per-session source", fifoName);
+        return NULL;
+    }
+    // 读端已在手，此刻以非阻塞方式再开一个写端必然成功（不会 ENXIO）。
+    if (gFifoKeepaliveIndex < 2) {
+        int wfd = open(fifoName, O_WRONLY | O_NONBLOCK);
+        if (wfd >= 0) gFifoKeepaliveWriteFd[gFifoKeepaliveIndex++] = wfd;
+        else hardenedLog("P2: keepalive write fd failed for %s (errno=%d)", fifoName, errno);
+    }
+    ByteStreamFifoSource* src = ByteStreamFifoSource::createNew(*env, fid, 0, 50000);
+    if (src == NULL) {
+        fclose(fid);
+        hardenedLog("P2: cannot create source for %s; falling back to per-session source", fifoName);
+        return NULL;
+    }
+    // deleteWhenLastReplicaDies=False 是关键：默认 True 会在全部客户端断开后
+    // 自删 replicator（连带关闭输入源），常驻化就失效了。
+    StreamReplicator* replicator = StreamReplicator::createNew(*env, src, False);
+    FramedSource* dummyReplica = replicator->createStreamReplica();
+    MediaSink* dummySink = DummySink::createNew(*env, tag);
+    dummySink->startPlaying(*dummyReplica, NULL, NULL);
+    hardenedLog("P2: persistent replicator ready for %s", fifoName);
+    return replicator;
+}
