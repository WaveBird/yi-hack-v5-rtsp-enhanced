+#define RRTSP_OUTQ_MAX_FLOWS   8
+#define RRTSP_OUTQ_INIT_CAP    (32*1024)
+#define RRTSP_OUTQ_MAX_CAP     (192*1024)
+#define RRTSP_OUTQ_MAX_AGE_MS  6000
+#define RRTSP_OUTQ_RETRY_US    10000
