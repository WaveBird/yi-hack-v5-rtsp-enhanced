+struct RrtspOutq {
+  int sock;
+  Boolean used;
+  u_int8_t* buf;
+  unsigned cap, head, len;
+  struct sockaddr_storage peer;
+  socklen_t peerLen;
+  struct timeval blockedSince;
+  Boolean blocked;
+};
+
+static RrtspOutq sRrtspOutq[RRTSP_OUTQ_MAX_FLOWS];
+static UsageEnvironment* sRrtspOutqEnv = NULL;
+static Boolean sRrtspOutqRetryScheduled = False;
+static void rrtspOutqRetryTask(void*);
+
+static void rrtspOutqRelease(RrtspOutq* q) {
+  delete[] q->buf;
+  memset(q, 0, sizeof(*q));
+}
+
+// fd 会被内核复用。仅当队列里还有未发完的字节时才校验对端身份，
+// 正常路径零额外系统调用。
+static Boolean rrtspOutqPeerMatches(RrtspOutq* q) {
+  struct sockaddr_storage cur;
+  socklen_t curLen = sizeof cur;
+  if (getpeername(q->sock, (struct sockaddr*)&cur, &curLen) < 0) return False;
+  if (curLen != q->peerLen) return False;
+  return memcmp(&cur, &q->peer, curLen) == 0;
+}
+
+static RrtspOutq* rrtspOutqFor(int sock) {
+  RrtspOutq* slot = NULL;
+  for (int i = 0; i < RRTSP_OUTQ_MAX_FLOWS; ++i) {
+    if (sRrtspOutq[i].used && sRrtspOutq[i].sock == sock) {
+      if (sRrtspOutq[i].len > 0 && !rrtspOutqPeerMatches(&sRrtspOutq[i])) {
+        rrtspOutqRelease(&sRrtspOutq[i]); // 旧连接已关闭，fd 被新连接复用
+        continue;
+      }
+      return &sRrtspOutq[i];
+    }
+    if (!sRrtspOutq[i].used && slot == NULL) slot = &sRrtspOutq[i];
+  }
+  if (slot == NULL) return NULL;
+  memset(slot, 0, sizeof(*slot));
+  slot->peerLen = sizeof slot->peer;
+  if (getpeername(sock, (struct sockaddr*)&slot->peer, &slot->peerLen) < 0) return NULL;
+  slot->cap = RRTSP_OUTQ_INIT_CAP;
+  slot->buf = new u_int8_t[slot->cap];
+  if (slot->buf == NULL) return NULL;
+  slot->sock = sock;
+  slot->used = True;
+  return slot;
+}
+
+// 返回 1=已排空, 0=内核缓冲满(稍后重试), -1=硬错误(需断链)
+static int rrtspOutqDrain(RrtspOutq* q) {
+  while (q->len > 0) {
+    ssize_t w = send(q->sock, (char const*)(q->buf + q->head), q->len,
+                     MSG_DONTWAIT | MSG_NOSIGNAL);
+    if (w > 0) { q->head += (unsigned)w; q->len -= (unsigned)w; continue; }
+    if (w < 0 && errno == EINTR) continue;
+    if (w < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) return 0;
+    return -1;
+  }
+  q->head = 0;
+  q->blocked = False;
+  return 1;
+}
+
+static Boolean rrtspOutqAppend(RrtspOutq* q, u_int8_t const* hdr,
+                               u_int8_t const* pkt, unsigned pktSize) {
+  unsigned need = 4 + pktSize;
+  if (q->head + q->len + need > q->cap) {
+    if (q->len > 0) memmove(q->buf, q->buf + q->head, q->len);
+    q->head = 0;
+    if (q->len + need > q->cap) {
+      unsigned newCap = q->cap;
+      while (newCap < q->len + need && newCap < RRTSP_OUTQ_MAX_CAP) newCap *= 2;
+      if (q->len + need > newCap) return False;
+      u_int8_t* nb = new u_int8_t[newCap];
+      if (nb == NULL) return False;
+      memcpy(nb, q->buf, q->len);
+      delete[] q->buf;
+      q->buf = nb;
+      q->cap = newCap;
+    }
+  }
+  memcpy(q->buf + q->head + q->len, hdr, 4);
+  memcpy(q->buf + q->head + q->len + 4, pkt, pktSize);
+  q->len += need;
+  return True;
+}
+
+static void rrtspOutqScheduleRetry() {
+  if (sRrtspOutqRetryScheduled || sRrtspOutqEnv == NULL) return;
+  sRrtspOutqRetryScheduled = True;
+  sRrtspOutqEnv->taskScheduler().scheduleDelayedTask(
+      RRTSP_OUTQ_RETRY_US, (TaskFunc*)rrtspOutqRetryTask, NULL);
+}
+
+static void rrtspOutqRetryTask(void*) {
+  sRrtspOutqRetryScheduled = False;
+  Boolean any = False;
+  for (int i = 0; i < RRTSP_OUTQ_MAX_FLOWS; ++i) {
+    RrtspOutq* q = &sRrtspOutq[i];
+    if (!q->used || q->len == 0) continue;
+    if (!rrtspOutqPeerMatches(q)) { rrtspOutqRelease(q); continue; }
+    int r = rrtspOutqDrain(q);
+    if (r < 0) {
+      rrtspTcpFailureNotify(q->sock, 5, 0);
+      shutdown(q->sock, SHUT_RDWR);
+      rrtspOutqRelease(q);
+      continue;
+    }
+    if (q->len > 0) any = True;
+  }
+  if (any) rrtspOutqScheduleRetry();
+}
