+// ===== 加固(P11)：拥塞排队取证钩子（节流） =====
+// RTPInterface 在每个「帧已完整入队但内核发送缓冲暂时排不空」的调用上通知这里。
+// 拥塞期间每秒可达 100~200 次调用，相机 /tmp 是 tmpfs 且 MemFree 常仅 1-3MB，
+// 必须聚合成每秒一行，否则日志本身会变成新的负载与空间风险。
+// P7 的「丢整包」语义已由 P11 的「排队不丢字节」取代：连接保持、TCP 流对齐、
+// 一个字节都不丢，客户端不重连、不再从 GOP 中间起播。
+volatile unsigned gP11QueueEvents = 0;
+extern "C" void rrtspTcpDropNotify(int socketNum, unsigned char channel, unsigned packetSize) {
+    gP11QueueEvents++;
+    static time_t lastLog = 0;
+    static unsigned sinceLast = 0;
+    time_t now = time(NULL);
+    sinceLast++;
+    if (now != lastLog) {
+        hardenedLog("P11: tcp output queue blocked socket=%d ch=%u queued=%uB events=%u total=%u; connection kept",
+                    socketNum, (unsigned)channel, packetSize, sinceLast, gP11QueueEvents);
+        lastLog = now;
+        sinceLast = 0;
+    }
+}
+// ===== 加固(P11) 结束 =====
+
+// ===== 加固(P13)：StreamReplicator 静默截断取证钩子（节流） =====
+// liveMedia/StreamReplicator.cpp 的 copyReceivedFrame() 在目标副本缓冲小于
+// 帧长时会把尾部字节丢掉（live555 原生行为，且 StreamParser 忽略
+// numTruncatedBytes）。P12 把 FIFO 读块限到 4096B、P13 让 parser bank 恒留
+// >=8192B 空间后，这个钩子应当永远不触发。留着它做现场「零截断」的直接证据。
+volatile unsigned gP13TruncEvents = 0;
+extern "C" void rrtspReplicaTruncNotify(unsigned frameSize, unsigned maxSize) {
+    gP13TruncEvents++;
+    static time_t lastLog = 0;
+    static unsigned sinceLast = 0;
+    time_t now = time(NULL);
+    sinceLast++;
+    if (now != lastLog) {
+        hardenedLog("P13: replica truncation frame=%u max=%u lost=%u events=%u total=%u",
+                    frameSize, maxSize,
+                    frameSize > maxSize ? frameSize - maxSize : 0,
+                    sinceLast, gP13TruncEvents);
+        lastLog = now;
+        sinceLast = 0;
+    }
+}
+// ===== 加固(P13) 结束 =====
