+// ===== 加固(P11a)：解除内核 wmem_max 对 SO_SNDBUF 的封顶 =====
+// 相机默认 net.core.wmem_max = 163840，会把 GenericMediaServer 里
+// setsockopt(SO_SNDBUF, 512KB) 静默截断回 160KB。这里在启动时把上限
+// 提到 1MB；只放宽上限、不改变默认值，也不触碰 tcp_wmem 的自动调优。
+static void raiseTcpWmemMax() {
+    int fd = open("/proc/sys/net/core/wmem_max", O_WRONLY);
+    if (fd < 0) return;
+    static char const value[] = "1048576\n";
+    ssize_t w = write(fd, value, sizeof(value) - 1);
+    close(fd);
+    hardenedLog("P11a: net.core.wmem_max -> 1048576 (write=%d)", (int)w);
+}
