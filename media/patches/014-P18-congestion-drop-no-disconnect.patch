+volatile unsigned gP18DropFrames = 0;
+extern "C" void rrtspTcpDropFrameNotify(int socketNum, unsigned frames, unsigned bytes) {
+    gP18DropFrames += frames;
+    static time_t lastLog = 0;
+    static unsigned framesSinceLog = 0;
+    static unsigned bytesSinceLog = 0;
+    framesSinceLog += frames;
+    bytesSinceLog += bytes;
+    time_t now = time(NULL);
+    if (now != lastLog) {
+        hardenedLog("P18: congestion drop frames=%u bytes=%u total=%u socket=%d; connection kept",
+                    framesSinceLog, bytesSinceLog, gP18DropFrames, socketNum);
+        lastLog = now;
+        framesSinceLog = 0;
+        bytesSinceLog = 0;
+    }
