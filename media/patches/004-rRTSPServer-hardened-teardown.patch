+#include <fcntl.h> // O_WRONLY (P4v2 日志)
+extern UsageEnvironment* env; // 定义在下方（P4v2 任务需提前引用）
+u_int64_t gLastVideoReadMs = 0; // 视频源最近一次读到帧的时刻（ByteStreamFifoSource 更新）
+
+static void hardenedLog(const char* fmt, ...) {
+    // 低频事件日志写 RAM（/tmp），避免伤 SD 卡。
+    // 用 open/write 而非 stdio：内存紧张时 fopen 的缓冲分配会静默失败。
+    static int logFd = -1;
+    if (logFd < 0) {
+        logFd = open("/tmp/rrtsp_hardened.log", O_WRONLY | O_APPEND | O_CREAT, 0644);
+        if (logFd < 0) return;
+    }
+    char buf[256];
+    struct timeval tv; gettimeofday(&tv, NULL);
+    struct tm tmv; localtime_r(&tv.tv_sec, &tmv);
+    int n = snprintf(buf, sizeof(buf),
+                     "%04d-%02d-%02d %02d:%02d:%02d ",
+                     tmv.tm_year + 1900, tmv.tm_mon + 1, tmv.tm_mday,
+                     tmv.tm_hour, tmv.tm_min, tmv.tm_sec);
+    va_list ap; va_start(ap, fmt);
+    n += vsnprintf(buf + n, sizeof(buf) - n, fmt, ap);
+    va_end(ap);
+    if (n > 0 && n < (int)sizeof(buf)) {
+        buf[n++] = '\n';
+        if (write(logFd, buf, n) < 0 && (errno == EBADF || errno == EIO)) logFd = -1;
+    }
+}
+
+static u_int64_t hardenedNowMs() {
+    struct timeval tv; gettimeofday(&tv, NULL);
+    return (u_int64_t)tv.tv_sec * 1000 + tv.tv_usec / 1000;
+}
