+static void healthCheckTask(void* /*clientData*/);
+static void scheduleHealthCheck() {
+    env->taskScheduler().scheduleDelayedTask(
+        HEALTH_CHECK_INTERVAL_MS * 1000, (TaskFunc*)healthCheckTask, NULL);
+}
+
+static void healthCheckTask(void* /*clientData*/) {
+    // 最终判据（v3，多轮取证后定稿）：客户端停读时 wlan0 出口立刻塌（TCP 窗口归零），
+    // 而内核缓冲可吸收 10-15s、sink 可能停止拉帧 —— tx_queue/EAGAIN 打点均滞后或失效。
+    // 故直接测 wlan0 出口速率：有客户端在播但出口 <15KB/s 连续 3 轮(3s) = 渗漏/塌陷态
+    // （正常 118-147KB/s，静态低码率 ~25KB/s，渗漏态 ~7KB/s，真塌 <1KB/s）→ 拆除重建。
+    // 3s 判定 + ~5s 重建 ≈ 8s 断流窗口，远短于 wd_stream strike4（20s）+killall 路径。
+    static unsigned lastTx = 0;
+    static int lowRounds = 0;
+    if (g_rtspServer == NULL || g_smsHigh == NULL) { scheduleHealthCheck(); return; }
+
+    if (g_smsHigh->referenceCount() > 0) {
+        unsigned tx = 0;
+        int fd = open("/proc/net/dev", O_RDONLY);
+        if (fd >= 0) {
+            char buf[4096];
+            int n = read(fd, buf, sizeof(buf) - 1);
+            close(fd);
+            if (n > 0) {
+                buf[n] = '\0';
+                char* p = strstr(buf, "wlan0");
+                if (p != NULL) sscanf(p, "wlan0:%*u %*u %*u %*u %*u %*u %*u %*u %u", &tx);
+            }
+        }
+        if (lastTx != 0 && tx >= lastTx) {
+            unsigned delta = tx - lastTx; // 1s 内 wlan0 出口字节
+            if (delta < 15 * 1024) {
+                lowRounds++;
+                // 拆除冷却：密集渗漏时段重建出的新会话可能立刻又渗漏，
+                // 连拆会把多个 8-10s 窗口拼成 20-40s 的长断流（15:06 CST 实测）。
+                // 拆除后 20s 内不再拆，给新会话建立与客户端 probe 留时间。
+                if (lowRounds >= 3) {
+                    static time_t lastTeardown = 0;
+                    time_t nowSec = time(NULL);
+                    if (lastTeardown != 0 && nowSec - lastTeardown < 20) {
+                        hardenedLog("egress %u B/s but cooldown active; skipping teardown", delta);
+                        lowRounds = 2; // 保持待命，冷却期一过即可再拆
+                    } else {
+                        hardenedLog("egress %u B/s with %u client(s); tearing down sessions",
+                                    delta, g_smsHigh->referenceCount());
+                        if (g_smsHigh != NULL) g_rtspServer->closeAllClientSessionsForServerMediaSession(g_smsHigh);
+                        if (g_smsLow != NULL) g_rtspServer->closeAllClientSessionsForServerMediaSession(g_smsLow);
+                        lastTeardown = nowSec;
+                        lowRounds = 0;
+                        lastTx = 0;
+                        scheduleHealthCheck();
+                        return;
+                    }
+                }
+            } else {
+                if (lowRounds >= 2)
+                    hardenedLog("egress recovered after %d low round(s)", lowRounds);
+                lowRounds = 0;
+            }
+        }
+        lastTx = tx;
+    } else {
+        lowRounds = 0;
+        lastTx = 0;
+    }
+    scheduleHealthCheck();
+}
