--- a/src/ByteStreamFifoSource.cpp
+++ b/src/ByteStreamFifoSource.cpp
@@ -139,6 +139,30 @@
     if (fPreferredFrameSize > 0 && fPreferredFrameSize < fMaxSize) {
         fMaxSize = fPreferredFrameSize;
     }
+    // 加固(P12) 根因修复：把单次 FIFO 读块固定到 4096 字节。
+    //
+    // P2 把 ByteStreamFifoSource 接到 StreamReplicator 上，下游的
+    // H264VideoStreamFramer / StreamParser 每次按
+    //   maxNumBytesToRead = BANK_SIZE(150000) - fTotNumValidBytes
+    // 申请缓冲，这个值是随 parser bank 占用率变化的（现场约 83~99KB）。
+    // StreamReplicator 的 primary 副本是常驻 DummySink（固定 100000 字节），
+    // 源一次最多读 100000 字节；而 StreamReplica::copyReceivedFrame() 在
+    // 目标副本 fMaxSize 偏小时会**静默截断**，StreamParser::afterGettingBytes()
+    // 又忽略 numTruncatedBytes —— 于是 H264 字节流中间凭空少 1~17KB，
+    // 正好把 62~63KB 的 IDR 削成 45~60KB，解码器 concealment 渲染成
+    // 绿屏 / 下半幅竖向拉丝。
+    //
+    // 同窗 A/B（2026-11-08 04:06 UTC）证实：grabber 镜像 IDR 稳定 62~63KB，
+    // RTSP wire 同位置 IDR 普遍少 1~17KB；其中连续 7 帧 diff=0（链路能通，
+    // 只是周期性截断）。RTP 序号零缺口，说明不是丢包而是字节被吞。
+    //
+    // 4096 << 任何可能的 parser 申请量（最坏也有约 75KB），因此
+    // copyReceivedFrame() 永远不需要截断。代价是读次数从约 1.3/s 升到
+    // 约 32/s，在 600MHz 相机上可忽略。不用 preferredFrameSize 实现，
+    // 是为了保留原有的墙钟 presentationTime 语义。
+    if (fMaxSize > 4096) {
+        fMaxSize = 4096;
+    }
 #ifdef READ_FROM_FILES_SYNCHRONOUSLY
     fFrameSize = fread(fTo, 1, fMaxSize, fFid);
